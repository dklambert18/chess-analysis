{
  "manifest_version": 3,
  "name": "chess.com --> Lichess",
  "version": "2.1",

  "description": "Analyze your Chess.com games on Lichess for free, and see stats on your openings, colors and streaks.",

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "Analyze on Lichess",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },

  "permissions": [
    "storage",
    "activeTab"
  ],

  "host_permissions": [
    "https://api.chess.com/*",
    "https://lichess.org/*"
  ]
}
